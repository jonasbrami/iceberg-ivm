server:
  port: 8000
  config_reload_interval_seconds: 30
  # SQLite file with each view's bookmark (the last source snapshot it
  # merged), any in-flight run, status and freshness, recent queries and the
  # maintenance schedule. Keep it on persistent storage: without it every view
  # rebuilds from scratch. Relative paths resolve next to the views file.
  # state_db_path: /data/state.db

# Trino connection URL, user, and password are read from environment
# variables — *never* from this file. No defaults; iceberg-ivm
# refuses to start without them.
#
#   TRINO_URL         e.g. "http://trino:8080" (required)
#   TRINO_USER        e.g. "iceberg-ivm"       (required)
#   TRINO_PASSWORD    BasicAuth password        (optional — omit for anonymous)
#   TRINO_PUBLIC_URL  Browser-reachable Trino URL used to rewrite per-query
#                     info_uri deep-links in the UI (optional — defaults to
#                     TRINO_URL). Set when the orchestrator and the user's
#                     browser reach Trino over different hostnames.
#   IVM_PASSWORD      Protects the UI and API with HTTP Basic auth (optional,
#                     any user name). /health and /metrics stay open.
#
# Only `catalog` and `schema` (the per-deployment Trino catalog + target
# schema — not secrets) live in this file.
trino:
  catalog: iceberg
  schema: analytics
